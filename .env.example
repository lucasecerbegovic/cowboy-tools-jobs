# Public site origin. Required in production so Open Graph image URLs are absolute.
# NEXT_PUBLIC_SITE_URL="https://tradesboard.example"

# SQLite file for local/dev. Swap to a Postgres/Supabase URL later
# (and set prisma/schema.prisma datasource provider to "postgresql").
DATABASE_URL="file:./dev.db"

# Optional: protect POST /api/ingest and /api/ingest/:source
# Required in production.
INGEST_SECRET="replace-with-a-cron-secret"

# Adzuna API (https://developer.adzuna.com). Canada only. If missing, Adzuna ingest is skipped.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Optional. Publishable pk_ key from https://www.logo.dev — pulls real logos
# by employer domain or name. Safe to expose in the browser.
# NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=""

# Optional live Job Bank open-data CSV. Ingest uses data/job-bank-fixture.csv by default.
# JOB_BANK_CSV_URL="https://open.canada.ca/data/dataset/ea639e28-c0fc-48bf-b5dd-b8899bd43072/resource/07546deb-70f5-4638-b34b-7c4321264972/download/job-bank-open-data-all-job-postings-en-aug2026.csv"
# JOB_BANK_CSV_PATH=""
# Restrict Job Bank ingest: west = MB, SK, AB, BC, YT, NT, NU. Or a comma list (BC,AB).
# JOB_BANK_REGIONS="west"
