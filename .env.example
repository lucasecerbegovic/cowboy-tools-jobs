# SQLite file for local/dev. Swap to a Postgres/Supabase URL later
# (and set prisma/schema.prisma datasource provider to "postgresql").
DATABASE_URL="file:./dev.db"

# Sign session cookies. Change this in any shared or production environment.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: protect POST /api/ingest and /api/ingest/:source
INGEST_SECRET="replace-with-a-cron-secret"

# Adzuna API (https://developer.adzuna.com). If missing, Adzuna ingest is skipped.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# USAJOBS Search API (https://developer.usajobs.gov). If missing, USAJOBS ingest is skipped.
USAJOBS_API_KEY=""
USAJOBS_USER_AGENT="tradesboard@localhost"

# Optional live Job Bank open-data CSV. Ingest uses /data/job-bank-fixture.csv by default.
# Example (July 2026 EN): https://open.canada.ca/data/dataset/ea639e28-c0fc-48bf-b5dd-b8899bd43072/resource/6f422ded-5d9b-4ce6-b471-92fe46d1c734/download/job-bank-open-data-all-job-postings-en-july2026.csv
JOB_BANK_CSV_URL=""
JOB_BANK_CSV_PATH=""
